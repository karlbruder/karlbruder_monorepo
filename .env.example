# Docker Compose: deixe DATABASE_URL ausente para usar o Postgres local.
# Para usar o Supabase no Compose, copie este arquivo para .env e descomente:
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require

# Backend executado diretamente na máquina host (fora do Docker):
# DATABASE_URL=postgresql://user:password@localhost:5432/kb-db
