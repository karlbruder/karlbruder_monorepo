# local and test use those settings classes.
# Any other name uses AWS settings and requires SECRET_NAME.
ENV_NAME=local

# Domain PostgreSQL. The URL is built from these values.
# Local Compose uses host db. A backend process on the host uses localhost.
# Production can leave the password, and the other values, in Secrets Manager.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres

# Required for protected API requests. Hosted Supabase HTTPS project root.
SUPABASE_URL=

# Hosted Supabase PostgreSQL for /health/auth.
# This is not the Compose domain database. Sign-in does not use these values.
AUTH_DB_USER=supabase
AUTH_DB_PASSWORD=supabase
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_NAME=supabase

# AWS environments. The secret is a JSON object whose keys match the names above.
# Environment variables already set on the process are kept.
# Secrets Manager fills only the names that are still empty.
# SECRET_NAME=
# AWS_REGION=
