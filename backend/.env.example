# Local Compose reaches PostgreSQL through the db service name.
# A backend process on the host uses localhost instead of db.
# Production uses the hosted Supabase PostgreSQL URI in this same file.
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# Required for protected API requests. Hosted Supabase HTTPS project root.
SUPABASE_URL=

# Optional hosted PostgreSQL URI for /health/auth only.
# Sign-in and token verification do not need it.
AUTH_DATABASE_URL=
