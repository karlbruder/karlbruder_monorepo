# Environment. local and test use those classes. Any other name uses AWS settings.
ENV_NAME=local

# Domain PostgreSQL.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres

# Supabase project root.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hosted Supabase Postgres for Auth diagnostics and current email lookup.
AUTH_DB_USER=supabase
AUTH_DB_PASSWORD=supabase
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_NAME=supabase

# Ministack private files. Compose also sets these on the backend service.
# S3_ENDPOINT_URL is for server-side calls. S3_BROWSER_ENDPOINT_URL is only for presigned URLs the browser opens.
S3_BUCKET_NAME=kb-local-bucket
S3_ENDPOINT_URL=http://ministack:4566
S3_BROWSER_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=aws-fake-access-key-id
AWS_SECRET_ACCESS_KEY=aws-fake-secret-access-key

# AWS environments. Both are required when ENV_NAME is not local or test.
# SECRET_NAME=
# AWS_REGION=

# Application mail uses authenticated STARTTLS. Leave disabled until SES is configured.
SMTP_ENABLED=false
SMTP_FROM="Suporte Karlbrüder <no-reply@karlbruder.com.br>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=5
# Browser application origin, with no path, credentials, query, or fragment.
APP_BASE_URL=http://localhost:5173

# Set the backend project's DSN. Monitoring stays off until explicitly enabled.
SENTRY_DSN=https://<project_id>@sentry.io/<project_id>
SENTRY_ENABLED=false
# SENTRY_SUCCESS_TRANSACTION_SAMPLE_RATE=0.1
