# Environment. local and test use those classes. Any other name uses AWS settings.
ENV_NAME=local

# Domain PostgreSQL.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres

# Supabase project root.
SUPABASE_URL=

# Hosted Supabase Postgres for /health/auth. Not the Compose database.
AUTH_DB_USER=supabase
AUTH_DB_PASSWORD=supabase
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_NAME=supabase

# AWS environments.
# SECRET_NAME=
# AWS_REGION=
