#!/bin/bash
set -Eeuo pipefail

PROJECT_NAME="${project_name}"
DEPLOY_PATH="${deploy_path}"

on_bootstrap_exit() {
  status="$?"
  if [ "$status" -ne 0 ]; then
    echo "EC2 user_data bootstrap failed with exit status $status" >&2
    systemctl --no-block isolate emergency.target || true
  fi
  exit "$status"
}
trap on_bootstrap_exit EXIT

log() {
  echo "[$(date --iso-8601=seconds)] $*"
}

install_base_packages() {
  log "Installing base packages for $PROJECT_NAME"
  apt-get update -y
  apt-get install -y --no-install-recommends ca-certificates curl unzip
}

install_cloudwatch_agent() {
  log "Installing and configuring CloudWatch agent"
  host_architecture="$(dpkg --print-architecture)"
  curl -fsSL "https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/$${host_architecture}/latest/amazon-cloudwatch-agent.deb" -o "/tmp/amazon-cloudwatch-agent.deb"
  dpkg -i -E /tmp/amazon-cloudwatch-agent.deb
  rm -f /tmp/amazon-cloudwatch-agent.deb

  mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
  cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWAGENT_CONFIG_EOF'
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "append_dimensions": {
      "InstanceId": "$${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "*"
        ],
        "drop_device": true,
        "ignore_file_system_types": [
          "sysfs",
          "devtmpfs",
          "tmpfs",
          "proc",
          "overlay",
          "squashfs",
          "devfs",
          "tracefs",
          "cgroup2",
          "nsfs",
          "ramfs",
          "debugfs",
          "configfs",
          "securityfs",
          "fusectl",
          "pstore",
          "autofs",
          "mqueue",
          "hugetlbfs"
        ]
      }
    }
  }
}
CWAGENT_CONFIG_EOF

  /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
    -a fetch-config \
    -m ec2 \
    -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
    -s
  systemctl enable amazon-cloudwatch-agent
}

install_aws_cli() {
  if command -v aws >/dev/null 2>&1; then
    log "AWS CLI already installed"
    return
  fi

  log "Installing AWS CLI v2"
  case "$(dpkg --print-architecture)" in
    amd64)
      aws_cli_architecture="x86_64"
      ;;
    arm64)
      aws_cli_architecture="aarch64"
      ;;
    *)
      echo "Unsupported CPU architecture: $(dpkg --print-architecture)" >&2
      exit 1
      ;;
  esac
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$${aws_cli_architecture}.zip" -o "/tmp/awscliv2.zip"
  rm -rf /tmp/aws
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
}

install_docker() {
  log "Installing Docker Engine and the Compose plugin"
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc

  cat > /etc/apt/sources.list.d/docker.sources << EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "$${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

  apt-get update -y
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable --now docker
}

configure_users_and_paths() {
  log "Configuring deploy path and Docker group access"
  if id ubuntu >/dev/null 2>&1; then
    usermod -aG docker ubuntu
  fi

  mkdir -p "$DEPLOY_PATH"
  chgrp docker "$DEPLOY_PATH"
  chmod 775 "$DEPLOY_PATH"
}

ensure_session_manager_agent() {
  log "Ensuring the Session Manager agent is installed"
  if ! snap list amazon-ssm-agent >/dev/null 2>&1; then
    snap install amazon-ssm-agent --classic
  fi

  systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service
}

ensure_ssm_user_docker_access() {
  log "Ensuring ssm-user can run Docker and sudo"
  if ! id ssm-user >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash ssm-user
  fi

  usermod -aG docker ssm-user
  usermod -aG sudo ssm-user

  cat > /etc/sudoers.d/90-ssm-user-nopasswd << 'SSM_SUDOERS_EOF'
ssm-user ALL=(ALL) NOPASSWD:ALL
SSM_SUDOERS_EOF
  chmod 440 /etc/sudoers.d/90-ssm-user-nopasswd
}

main() {
  ${userdata_pre_install}

  install_base_packages
  install_cloudwatch_agent
  install_aws_cli
  install_docker
  configure_users_and_paths
  ensure_session_manager_agent
  ensure_ssm_user_docker_access

  ${userdata_post_install}

  log "EC2 user_data bootstrap completed"
}

main "$@"
