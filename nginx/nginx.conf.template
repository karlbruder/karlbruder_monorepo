server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate /etc/nginx/certs/origin.crt;
    ssl_certificate_key /etc/nginx/certs/origin.key;

    return 404;
}

server {
    listen 443 ssl;
    server_name ${LANDING_HOSTNAMES};

    resolver 127.0.0.11 valid=2s ipv6=off;
    resolver_timeout 2s;
    error_page 502 503 504 =503 /maintenance.html;

    ssl_certificate /etc/nginx/certs/origin.crt;
    ssl_certificate_key /etc/nginx/certs/origin.key;

    location = /maintenance.html {
        internal;
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store" always;
    }

    location = /maintenance.png {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store" always;
    }

    location / {
        if (-f /var/run/karlbruder-maintenance/enabled) { return 503; }
        set $landing_upstream landing;
        proxy_pass http://$landing_upstream:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl;
    server_name ${APPLICATION_HOSTNAMES};

    resolver 127.0.0.11 valid=2s ipv6=off;
    resolver_timeout 2s;
    error_page 502 503 504 =503 /maintenance.html;

    ssl_certificate /etc/nginx/certs/origin.crt;
    ssl_certificate_key /etc/nginx/certs/origin.key;

    location = /maintenance.html {
        internal;
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store" always;
    }

    location = /maintenance.png {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store" always;
    }

    location = /api {
        if (-f /var/run/karlbruder-maintenance/enabled) { return 503; }
        set $backend_upstream backend;
        proxy_pass http://$backend_upstream:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        if (-f /var/run/karlbruder-maintenance/enabled) { return 503; }
        set $backend_upstream backend;
        proxy_pass http://$backend_upstream:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        if (-f /var/run/karlbruder-maintenance/enabled) { return 503; }
        set $frontend_upstream frontend;
        proxy_pass http://$frontend_upstream:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
